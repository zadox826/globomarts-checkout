# ---------------------------------------------------------------------------
# PRODUCTION .env for checkout.ninjjakoffe.site
# Copy to .env on the server and fill in the two keys. chmod 600 .env
# NEVER commit the real .env.
# ---------------------------------------------------------------------------

CHARGEBEE_SITE=ninjjakoffe-test

# Secret API key — server-side only, never sent to the browser.
# Dashboard > Settings > Configure Chargebee > API Keys and Webhooks > API Keys
CHARGEBEE_API_KEY=your_test_or_live_api_key_here

# Publishable key — REQUIRED for card fields + PayPal button. Browser-safe.
# Dashboard > ... > API Keys > Add API Key > Publishable Key (starts with test__)
CHARGEBEE_PUBLISHABLE_KEY=your_publishable_key_here

ITEM_PRICE_ID=basic-eur-monthly

# IMPORTANT: these must match the public domain, and that domain must be
# allowlisted in Chargebee:
#   Settings > Configure Chargebee > Checkout & Self-Serve Portal
#   > Advanced Settings > Add domains  ->  https://checkout.ninjjakoffe.site
REDIRECT_URL=https://checkout.ninjjakoffe.site/success
CANCEL_URL=https://checkout.ninjjakoffe.site/cancel

PORT=3000
NODE_ENV=production
