# Copy this file to .env and fill in real values. NEVER commit .env.

# Your Chargebee site (the billing subdomain, e.g. "ninjjakoffe-test")
CHARGEBEE_SITE=ninjjakoffe-test

# A *test mode* API key while developing (key starts with "test_").
# Dashboard > Settings > Configure Chargebee > API Keys > Add API Key
# Keep this ONLY on the server. Never send it to the browser.
CHARGEBEE_API_KEY=your_test_api_key_here

# Publishable key — REQUIRED for the custom checkout page (Card Components +
# PayPal button). It is browser-safe by design.
# Dashboard > Settings > Configure Chargebee > API Keys and Webhooks > API Keys
# > Add API Key > Publishable Key. Paste the key here.
CHARGEBEE_PUBLISHABLE_KEY=your_publishable_key_here

# Item price sold by the custom checkout page (must exist in your catalog)
ITEM_PRICE_ID=basic-eur-monthly

# For local testing, these point at the included demo pages.
# In production, change them to your real domain, e.g. https://yoursite.com/success
REDIRECT_URL=http://localhost:3000/success
CANCEL_URL=http://localhost:3000/cancel

# Local server port
PORT=3000
